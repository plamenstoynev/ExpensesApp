@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView>
    <Authorized>
        <div class="auth-display">
            <span class="user-chip">@GetInitials(context.User.Identity?.Name)</span>
            <span class="user-email">@context.User.Identity?.Name</span>
            <a href="/account/logout" class="logout-btn">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Logout
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="auth-display">
            <a href="/account/login" class="btn btn-sm btn-primary">Login</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return name[0].ToString().ToUpperInvariant();
    }
}
