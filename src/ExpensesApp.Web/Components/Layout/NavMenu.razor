@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-container">
    <div class="nav-header">
        <h1 class="app-title">
            <span class="app-icon">
                <svg viewBox="0 0 24 24"><path d="M21 12V7a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h15v3" /><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-5" /><circle cx="18" cy="12" r="1.5" /></svg>
            </span>
            Expenses App
        </h1>
    </div>

    <AuthorizeView>
        <Authorized>
            <nav class="nav-menu">
                <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /></svg>
                    </span>
                    <span class="nav-text">Dashboard</span>
                </NavLink>

                <NavLink class="nav-item" href="/transactions">
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2.5" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                    </span>
                    <span class="nav-text">Transactions</span>
                </NavLink>

                <NavLink class="nav-item" href="/categories">
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24"><polygon points="3 4 13 4 21 12 13 20 3 20 3 12" /><circle cx="7.5" cy="12" r="1.4" /></svg>
                    </span>
                    <span class="nav-text">Categories</span>
                </NavLink>

                <NavLink class="nav-item" href="/budgets">
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" fill="currentColor" /></svg>
                    </span>
                    <span class="nav-text">Budgets</span>
                </NavLink>

                <NavLink class="nav-item" href="/reports">
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24"><line x1="5" y1="21" x2="5" y2="13" /><line x1="12" y1="21" x2="12" y2="7" /><line x1="19" y1="21" x2="19" y2="17" /></svg>
                    </span>
                    <span class="nav-text">Reports</span>
                </NavLink>
            </nav>
        </Authorized>
        <NotAuthorized>
            <div class="nav-guest">
                <p class="guest-message">Please log in to access your financial data.</p>
                <a href="/account/login" class="btn btn-primary">Login</a>
                <a href="/account/register" class="btn btn-outline">Register</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
