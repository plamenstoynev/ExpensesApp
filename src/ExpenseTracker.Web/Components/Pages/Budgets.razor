@page "/budgets"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using ExpenseTracker.Application.Common.Models
@using ExpenseTracker.Application.Features.Budgets.Commands.CreateBudget
@using ExpenseTracker.Application.Features.Budgets.Commands.DeleteBudget
@using ExpenseTracker.Application.Features.Budgets.Queries.GetBudgets
@using ExpenseTracker.Application.Features.Categories.Queries.GetCategories
@using ExpenseTracker.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@inject CreateBudgetCommandHandler CreateBudgetHandler
@inject DeleteBudgetCommandHandler DeleteBudgetHandler
@inject GetBudgetsQueryHandler GetBudgetsHandler
@inject GetCategoriesQueryHandler GetCategoriesHandler

<PageTitle>Budgets - Expense Tracker</PageTitle>

<div class="page-header mb-5">
    <h1>Budgets</h1>
    <p>Set monthly spending limits per category</p>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">Month</label>
        <select class="form-select" @bind="_selectedMonth" @bind:after="LoadBudgetsAsync">
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Year</label>
        <select class="form-select" @bind="_selectedYear" @bind:after="LoadBudgetsAsync">
            @for (var y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 2; y++)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3>Add Budget</h3>
            </div>
            <div class="card-body">
                @if (_expenseCategories.Count == 0)
                {
                    <p class="text-muted">Create an expense category first before adding a budget.</p>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="HandleCreate">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <InputSelect @bind-Value="_model.CategoryId" class="form-select">
                                <option value="0">-- Select category --</option>
                                @foreach (var category in _expenseCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Amount</label>
                            <InputNumber @bind-Value="_model.Amount" class="form-control" step="0.01" />
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@_isProcessing">Add Budget</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col">
        <div class="card">
            <div class="card-header">
                <h3>@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(_selectedMonth) @_selectedYear Budgets</h3>
            </div>
            <div class="card-body">
                @if (_budgets.Count == 0)
                {
                    <p class="text-muted">No budgets set for this month.</p>
                }
                else
                {
                    @foreach (var budget in _budgets)
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between">
                                <strong>@budget.CategoryName</strong>
                                <span>
                                    $@budget.Spent.ToString("F2") / $@budget.Amount.ToString("F2")
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => HandleDelete(budget.Id)">Delete</button>
                                </span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @(budget.PercentUsed >= 100 ? "bg-danger" : budget.PercentUsed >= 80 ? "bg-warning" : "bg-success")"
                                     role="progressbar"
                                     style="width: @(budget.PercentUsed)%;">
                                </div>
                            </div>
                            <small class="text-muted">@budget.Remaining.ToString("F2") remaining</small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int _selectedMonth = DateTime.UtcNow.Month;
    private int _selectedYear = DateTime.UtcNow.Year;
    private CreateBudgetModel _model = new();
    private IReadOnlyList<BudgetDto> _budgets = [];
    private IReadOnlyList<CategoryDto> _expenseCategories = [];
    private string? _errorMessage;
    private bool _isProcessing;

    protected override async Task OnInitializedAsync()
    {
        _expenseCategories = await GetCategoriesHandler.Handle(new GetCategoriesQuery { Type = TransactionType.Expense });
        await LoadBudgetsAsync();
    }

    private async Task LoadBudgetsAsync()
    {
        _budgets = await GetBudgetsHandler.Handle(new GetBudgetsQuery { Month = _selectedMonth, Year = _selectedYear });
    }

    private async Task HandleCreate()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            await CreateBudgetHandler.Handle(new CreateBudgetCommand
            {
                CategoryId = _model.CategoryId,
                Amount = _model.Amount,
                Month = _selectedMonth,
                Year = _selectedYear
            });

            _model = new CreateBudgetModel();
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task HandleDelete(int id)
    {
        _errorMessage = null;

        try
        {
            await DeleteBudgetHandler.Handle(new DeleteBudgetCommand(id));
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    public class CreateBudgetModel
    {
        public int CategoryId { get; set; }
        public decimal Amount { get; set; }
    }
}
